{
  "name": "cleanmysocial",
  "version": "0.1.0",
  "private": true,
  "description": "CleanMySocial — five social cleanup extensions, available separately or in one lifetime bundle",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:seo": "node scripts/check-seo.mjs",
    "lint": "next lint",
    "dev:sandbox": "node --env-file=.env.sandbox node_modules/next/dist/bin/next dev",
    "build:sandbox": "node --env-file=.env.sandbox node_modules/next/dist/bin/next build",
    "start:sandbox": "node --env-file=.env.sandbox node_modules/next/dist/bin/next start"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "next": "^15.1.0",
    "nodemailer": "^9.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
