# Copy to .env.sandbox and run `npm run dev:sandbox` (or the cleanmysocial-sandbox
# launch config) to work on the dashboards without touching production data.
#
# .env.local carries the live Upstash credentials, so a plain `npm run dev`
# writes to the real Redis. Blanking the KV vars here makes lib/store.ts fall
# back to its in-memory map: every page then shows the "Redis not configured"
# warning, and the map is cleared whenever the dev server recompiles.
ADMIN_TOKEN=sandbox-admin-token
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
